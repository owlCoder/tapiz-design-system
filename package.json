{
  "name": "@tapiz/ui",
  "version": "0.1.0",
  "description": "Centralized design system, theming foundation, and reusable React UI components for the Tapiz platform.",
  "license": "MIT",
  "type": "module",
  "author": "Tapiz UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlCoder/tapiz-design-system.git"
  },
  "homepage": "https://github.com/owlCoder/tapiz-design-system#readme",
  "bugs": {
    "url": "https://github.com/owlCoder/tapiz-design-system/issues"
  },
  "keywords": [
    "tapiz",
    "design-system",
    "ui",
    "react",
    "tailwindcss"
  ],
  "sideEffects": [
    "*.css",
    "./dist/fonts.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "FRAMEWORK_BOUNDARY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && powershell -Command \"Copy-Item -Path src/theme.css -Destination dist/theme.css -Force\"",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build",
    "pack:check": "npm pack --json"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
