{
  "name": "@tapizlabs/ui",
  "version": "3.0.34",
  "description": "Centralized design system, theming foundation, and reusable React UI components for the Tapiz platform.",
  "license": "MIT",
  "type": "module",
  "types": "./dist/index.d.ts",
  "author": "Tapiz UI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owlCoder/tapiz-design-system.git"
  },
  "homepage": "https://github.com/owlCoder/tapiz-design-system#readme",
  "bugs": {
    "url": "https://github.com/owlCoder/tapiz-design-system/issues"
  },
  "keywords": [
    "tapiz",
    "design-system",
    "ui",
    "react",
    "tailwindcss"
  ],
  "sideEffects": [
    "*.css",
    "./theme.css",
    "./tailwind-theme.css",
    "./fonts.css",
    "./dist/fonts.js",
    "./dist/fonts.css",
    "./dist/index.js",
    "./src/scrollGutter.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css",
    "./tailwind-theme.css": "./tailwind-theme.css",
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js"
    },
    "./fonts.css": "./fonts.css"
  },
  "files": [
    "dist",
    "theme.css",
    "tailwind-theme.css",
    "fonts.css",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "FRAMEWORK_BOUNDARY.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup && npm run build:css && npm run build:assets",
    "build:assets": "node scripts/build-assets.mjs",
    "build:css": "node scripts/copy-theme.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm run pack:check",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": ">=4"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/cli": "^4.3.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "lucide-react": "^1.24.0"
  }
}
